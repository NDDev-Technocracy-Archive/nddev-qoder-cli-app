{
  "general": {
    "defaultPermissionMode": "accept_edits",
    "enableAutoUpdate": false
  },
  "permissions": {
    "allow": ["Read", "Grep", "Glob", "Edit", "Write", "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)"],
    "ask": ["Bash(*)"],
    "deny": ["Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(git push:*)"]
  },
  "autoMode": {
    "enabled": false
  },
  "sandbox": {
    "gitAuth": false,
    "ghAuth": false,
    "network": "ask"
  },
  "enabledPlugins": {
    "nddev-builder@local": true
  },
  "extraKnownMarketplaces": {},
  "hooks": {
    "enabled": true
  },
  "tools": {
    "mcp": {}
  }
}
