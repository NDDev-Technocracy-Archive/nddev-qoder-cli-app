{
  "schema_version": 1,
  "id": "balanced",
  "description": "Balanced Qoder CLI setup using accept_edits with bounded tool allow and deny lists.",
  "managed_files": ["settings.json", "AGENTS.md"],
  "builder_projection": "native-plugin-plus-user-files",
  "builder_default_on": true,
  "launch_args": [
    "--permission-mode",
    "accept_edits",
    "--allowed-tools",
    "Read,Grep,Glob,Edit,Write,Bash(git status),Bash(git diff:*),Bash(git log:*)",
    "--disallowed-tools",
    "Bash(rm -rf:*),Bash(sudo:*),Bash(git push:*)"
  ]
}
