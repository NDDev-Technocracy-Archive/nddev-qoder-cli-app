{
  "general": {
    "defaultPermissionMode": "default",
    "enableAutoUpdate": false
  },
  "permissions": {
    "allow": ["Read", "Grep", "Glob"],
    "ask": ["Edit", "Write", "Bash(*)"],
    "deny": ["Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(git push:*)"]
  },
  "autoMode": {
    "enabled": false
  },
  "sandbox": {
    "gitAuth": false,
    "ghAuth": false,
    "network": "ask"
  },
  "enabledPlugins": {
    "nddev-builder@local": true
  },
  "extraKnownMarketplaces": {},
  "hooks": {
    "enabled": true
  },
  "tools": {
    "mcp": {}
  }
}
